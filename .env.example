# Generic Linux Docker host. Copy to a private .env and edit before starting.
IMAGE_REPOSITORY=local/open-apple-cache
IMAGE_TAG=docker
IMAGE_PULL_POLICY=never
UPSTREAM_COMMIT=68c69e693877f6351b960b755784852f55aa854f
CACHE_IP=192.168.1.50
CACHE_PORT=8080
ADMIN_PORT=8443
ALLOWED_CLIENTS=192.168.1.0/24
CONFIG_DIR=/srv/open-apple-cache/config
DATA_DIR=/srv/open-apple-cache/data
CACHE_MAX_GIB=50
RESERVE_GIB=10
MAX_OBJECT_GIB=20
MAX_DOWNLOADS=2
MEM_LIMIT=1g
CPU_LIMIT=1.0
