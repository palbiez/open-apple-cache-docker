+func TestOriginCacheControlNeverPreventsStorage(t *testing.T) {
+	for _, directives := range [][]string{
+		nil,
+		{"private"},
+		{"no-store"},
+		{"no-cache"},
+		{"private, no-store, no-cache, max-age=0, s-maxage=0"},
+		{"max-age=0", "private", "no-store"},
+		{"public, max-age=1"},
+		{"private=\"X-Example\""},
+		{"unknown-directive, max-age=invalid"},
+	} {
+		t.Run(strings.Join(directives, ";"), func(t *testing.T) {
+			var downloads atomic.Int64
+			p, _ := fixture(t, func(w http.ResponseWriter, r *http.Request) {
+				downloads.Add(1)
+				for _, directive := range directives {
+					w.Header().Add("Cache-Control", directive)
+				}
+				w.Header().Set("Age", "259200")
+				w.Header().Set("Date", time.Now().Add(-72*time.Hour).UTC().Format(http.TimeFormat))
+				w.Header().Set("Expires", time.Unix(1, 0).UTC().Format(http.TimeFormat))
+				w.Header().Set("Content-Length", "11")
+				io.WriteString(w, "app-package")
+			})
+			// Not restricted to an extension or special package path: every
+			// configured origin follows the same origin-header policy.
+			path := "/ordinary-download.bin?source=origin.test"
+			first := call(p, "GET", path, nil)
+			second := call(p, "GET", path, nil)
+			if first.Header().Get("X-Open-Apple-Cache") != "MISS" || second.Header().Get("X-Open-Apple-Cache") != "HIT" || downloads.Load() != 1 {
+				t.Fatalf("origin directives prevented storage: first=%s second=%s downloads=%d", first.Header().Get("X-Open-Apple-Cache"), second.Header().Get("X-Open-Apple-Cache"), downloads.Load())
+			}
+			if first.Body.String() != "app-package" || second.Body.String() != "app-package" {
+				t.Fatal("response body changed")
+			}
+			if strings.Join(second.Header().Values("Cache-Control"), ";") != strings.Join(directives, ";") {
+				t.Fatal("origin Cache-Control must still be forwarded")
+			}
+			u, _ := url.Parse("http://origin.test/ordinary-download.bin")
+			objects := p.store.candidates(contentIdentity(u), "")
+			if len(objects) != 1 {
+				t.Fatal("expected one persisted object")
+			}
+			for _, object := range objects {
+				if remaining := time.Until(object.Expires); remaining < 59*time.Minute || remaining > time.Hour {
+					t.Fatalf("unexpected local retention: %s", remaining)
+				}
+			}
+		})
+	}
+}
+
+func TestPrivateSignedPackageAliasAndRestart(t *testing.T) {
+	for _, requestRange := range []string{"", "bytes=2-5"} {
+		t.Run(requestRange, func(t *testing.T) {
+			var downloads atomic.Int64
+			p, c := fixture(t, func(w http.ResponseWriter, r *http.Request) {
+				downloads.Add(1)
+				w.Header().Set("Cache-Control", "private, no-store, no-cache, max-age=0")
+				w.Header().Set("ETag", "\"stable-app-version\"")
+				http.ServeContent(w, r, "app.ipa", time.Unix(1700000000, 0), strings.NewReader("0123456789abcdef"))
+			})
+			p.c.Origins = map[string]string{"iosapps.itunes.apple.com": "both"}
+			c.Origins = p.c.Origins
+			path := "/itunes-assets/Purple221/v4/version/app.ipa?source=iosapps.itunes.apple.com&token="
+			headers := map[string]string{}
+			if requestRange != "" {
+				headers["Range"] = requestRange
+			}
+			first := call(p, "GET", path+"first", headers)
+			second := call(p, "GET", path+"rotated", headers)
+			third := call(p, "GET", path+"rotated", headers)
+			if first.Header().Get("X-Open-Apple-Cache") != "MISS" || second.Header().Get("X-Open-Apple-Cache") != "HIT" || third.Header().Get("X-Open-Apple-Cache") != "HIT" || downloads.Load() != 2 {
+				t.Fatalf("private signed package not reused: first=%s second=%s third=%s origin=%d", first.Header().Get("X-Open-Apple-Cache"), second.Header().Get("X-Open-Apple-Cache"), third.Header().Get("X-Open-Apple-Cache"), downloads.Load())
+			}
+			for _, response := range []*httptest.ResponseRecorder{first, second, third} {
+				want := "0123456789abcdef"
+				if requestRange != "" {
+					want = "2345"
+					if response.Code != http.StatusPartialContent {
+						t.Fatal("partial status changed")
+					}
+				}
+				if response.Body.String() != want || response.Header().Get("X-Apple-Cache-Session") == "" || response.Header().Get("X-Apple-Cached-Ranges") == "" {
+					t.Fatal("body or Apple cache headers missing")
+				}
+			}
+			p2, err := newProxy(c)
+			if err != nil {
+				t.Fatal(err)
+			}
+			p2.client.Transport = p.client.Transport
+			afterRestart := call(p2, "GET", path+"after-restart", headers)
+			if afterRestart.Header().Get("X-Open-Apple-Cache") != "HIT" || downloads.Load() != 3 {
+				t.Fatal("persisted private package not revalidated/reused")
+			}
+		})
+	}
+}
+
+func TestPrivateAliasStillRejectsChangedRepresentation(t *testing.T) {
+	for _, change := range []string{"etag", "length"} {
+		t.Run(change, func(t *testing.T) {
+			p, _ := fixture(t, func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("Cache-Control", "private")
+				body, etag := "old-body", "\"v1\""
+				if r.URL.Query().Get("token") == "changed" {
+					if change == "etag" {
+						body, etag = "new-body", "\"v2\""
+					} else {
+						body = "longer-new-body"
+					}
+				}
+				w.Header().Set("ETag", etag)
+				http.ServeContent(w, r, "app.ipa", time.Unix(1700000000, 0), strings.NewReader(body))
+			})
+			p.c.Origins = map[string]string{"iosapps.itunes.apple.com": "both"}
+			path := "/Purple221/app.ipa?source=iosapps.itunes.apple.com&token="
+			call(p, "GET", path+"first", nil)
+			changed := call(p, "GET", path+"changed", nil)
+			if changed.Header().Get("X-Open-Apple-Cache") != "MISS" || changed.Body.String() == "old-body" {
+				t.Fatal("different object incorrectly aliased")
+			}
+		})
+	}
+}
