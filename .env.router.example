# Published image: local `docker compose build`, Router `docker compose up -d`.
IMAGE_REPOSITORY=palbiez1984/cacheserver
IMAGE_TAG=latest
IMAGE_PULL_POLICY=always
UPSTREAM_COMMIT=68c69e693877f6351b960b755784852f55aa854f

# Existing GUI gateway owns this address. Ports are served by its Nginx.
CACHE_IP=192.168.10.247
CACHE_PORT=8080
ADMIN_PORT=8446
ALLOWED_CLIENTS=192.168.20.0/24,192.168.30.0/24,192.168.10.0/24,192.168.40.0/24,192.168.50.0/24,192.168.60.0/24
WIREGUARD_NETWORK=10.77.0.0/16
GUI_BACKEND_NETWORK=proxy-guis_backend
GATEWAY_BACKEND_IP=172.30.20.2
CACHE_BACKEND_IP=172.30.20.8

# Existing folders on the Router. Preserve configuration, identity and cache.
CONFIG_DIR=/mnt/data/cacheserver/config
DATA_DIR=/mnt/data/cacheserver/data
CACHE_MAX_GIB=50
RESERVE_GIB=10
MAX_OBJECT_GIB=20
MAX_DOWNLOADS=2

MEM_LIMIT=1g
CPU_LIMIT=1.0
